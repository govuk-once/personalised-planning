      "rules": [
        {
          "step": 1,
          "question": "q_relationship_to_baby",
          "answers": [
            "giving_birth",
            "partner"
          ],
          "why": "Step 1 covers checking Statutory Maternity Pay/leave for the birth parent and Paternity Leave/Pay for the partner; adopting or surrogacy parents have different leave schemes and are not covered by this maternity/paternity guide."
        },
        {
          "step": 2,
          "question": "q_relationship_to_baby",
          "answers": [
            "giving_birth",
            "partner"
          ],
          "why": "Telling the employer and claiming maternity/paternity leave applies to birth parents and partners; adoption/surrogacy use separate processes."
        },
        {
          "step": 2,
          "fact": "fact_baby_born",
          "drop_when": true,
          "why": "This step (telling employer you're expecting, by the qualifying week) is a pre-birth notification task that no longer applies once the baby has already been born."
        },
        {
          "step": 2,
          "question": "q_employment_status",
          "answers": [
            "employee",
            "worker"
          ],
          "why": "Telling an employer and giving paternity notice need an employer; self-employed and non-working people have none.",
          "added_by": "manual review 2026-11-06"
        },
        {
          "step": 3,
          "question": "q_relationship_to_baby",
          "answers": [
            "giving_birth",
            "partner"
          ],
          "why": "Giving notice for Statutory Maternity Leave/Pay, Maternity Allowance, or Paternity notice applies to birth parents and partners specifically."
        },
        {
          "step": 3,
          "fact": "fact_baby_born",
          "drop_when": true,
          "why": "Giving notice for leave/pay to start is a pre-birth task that no longer applies once the baby has already been born."
        },
        {
          "step": 4,
          "question": "q_relationship_to_baby",
          "answers": [
            "giving_birth",
            "partner"
          ],
          "why": "Shared Parental Leave rules in this guide apply to birth parents and partners sharing leave; not relevant to adoption/surrogacy routes covered elsewhere."
        },
        {
          "step": 4,
          "question": "q_employment_status",
          "answers": [
            "employee",
            "worker"
          ],
          "why": "Shared Parental Leave is arranged with an employer.",
          "added_by": "manual review 2026-11-06"
        },
        {
          "step": 5,
          "question": "q_relationship_to_baby",
          "answers": [
            "giving_birth",
            "partner"
          ],
          "why": "Antenatal time off (paid for birth parent, unpaid for partner) applies specifically to these two roles."
        },
        {
          "step": 5,
          "fact": "fact_baby_born",
          "drop_when": true,
          "why": "Antenatal care appointments happen during pregnancy; once the baby is born this step is in the past and no longer applies."
        },
        {
          "step": 6,
          "question": "q_relationship_to_baby",
          "answers": [
            "giving_birth"
          ],
          "why": "Starting maternity leave applies only to the birth parent, not the partner."
        },
        {
          "step": 6,
          "question": "q_employment_status",
          "answers": [
            "employee",
            "worker"
          ],
          "why": "Statutory Maternity Leave is taken from an employer. (Strictly, leave is for employees only; workers can get pay but not leave.)",
          "added_by": "manual review 2026-11-06"
        },
        {
          "step": 6,
          "fact": "fact_baby_born",
          "drop_when": true,
          "why": "Maternity leave starts before or at the birth; once the baby is born, starting it is in the past.",
          "added_by": "manual review 2026-11-06"
        },
        {
          "step": 7,
          "question": "q_relationship_to_baby",
          "answers": [
            "giving_birth",
            "partner"
          ],
          "why": "Taking compulsory maternity leave or paternity leave after the birth applies specifically to the birth parent and partner."
        },
        {
          "step": 7,
          "question": "q_employment_status",
          "answers": [
            "employee",
            "worker"
          ],
          "why": "Compulsory maternity leave and Paternity Leave are taken from an employer. (Strictly, leave is for employees only.)",
          "added_by": "manual review 2026-11-06"
        },
        {
          "step": 10,
          "question": "q_employment_status",
          "answers": [
            "employee",
            "worker"
          ],
          "why": "Keeping-in-touch days, flexible working and returning to work need a job with an employer.",
          "added_by": "manual review 2026-11-06"
        }
