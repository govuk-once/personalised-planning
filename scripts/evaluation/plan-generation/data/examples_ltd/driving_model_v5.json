{
  "facts": [
    {
      "id": "fact_learning_to_drive",
      "description": "This person is learning to drive/ride and needs a provisional licence, theory test and practical test route",
      "value": {
        "==": [
          "q_main_goal",
          "learn_to_drive"
        ]
      },
      "source": [
        "/learn-to-drive-a-car",
        "/driving-lessons-learning-to-drive"
      ]
    },
    {
      "id": "fact_needs_provisional",
      "description": "This person does not yet have a provisional licence and needs to get one before learning to drive or ride",
      "value": {
        "==": [
          "q_have_provisional",
          "no"
        ]
      },
      "source": [
        "/apply-first-provisional-driving-licence"
      ]
    },
    {
      "id": "fact_vehicle_is_motorcycle_moped",
      "description": "This person is learning to ride a motorcycle or moped, so CBT and motorcycle-specific rules apply",
      "value": {
        "in": [
          "q_vehicle_type",
          [
            "motorcycle",
            "moped"
          ]
        ]
      },
      "source": [
        "/motorcycle-cbt",
        "/ride-motorcycle-moped"
      ]
    },
    {
      "id": "fact_needs_cbt",
      "description": "This person needs to complete compulsory basic training (CBT) before riding on the road",
      "value": {
        "and": [
          {
            "in": [
              "q_vehicle_type",
              [
                "motorcycle",
                "moped"
              ]
            ]
          },
          {
            "!=": [
              "q_cbt_exempt",
              "yes"
            ]
          },
          {
            "!=": [
              "fact_car_licence_exempts_moped_theory",
              true
            ]
          }
        ]
      },
      "source": [
        "/motorcycle-cbt"
      ]
    },
    {
      "id": "fact_car_licence_exempts_moped_theory",
      "description": "This person does not need to take a theory test for a moped because they passed their car driving test before 1 February 2001",
      "value": {
        "==": [
          "q_car_licence_before_2001",
          "yes"
        ]
      },
      "source": [
        "/motorcycle-cbt",
        "/theory-test"
      ]
    },
    {
      "id": "fact_needs_theory_test",
      "description": "This person needs to pass a theory test before booking their practical driving/riding test",
      "value": {
        "and": [
          {
            "==": [
              "q_main_goal",
              "learn_to_drive"
            ]
          },
          {
            "!=": [
              "q_vehicle_type",
              "upgrade_auto_to_manual"
            ]
          },
          {
            "!=": [
              "fact_car_licence_exempts_moped_theory",
              true
            ]
          },
          {
            "!=": [
              "q_has_theory_cert",
              "yes"
            ]
          }
        ]
      },
      "source": [
        "/theory-test",
        "/motorcycle-theory-test"
      ]
    },
    {
      "id": "fact_upgrading_licence",
      "description": "This person already holds a full licence and is upgrading to a higher category, so some steps (theory test, provisional licence) may not be required",
      "value": {
        "==": [
          "q_main_goal",
          "upgrade_licence"
        ]
      },
      "source": [
        "/adding-higher-categories-to-your-driving-licence",
        "/automatic-driving-licence-to-manual"
      ]
    },
    {
      "id": "fact_renewing_licence",
