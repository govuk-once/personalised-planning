  "questions": [
    {
      "id": "q_main_goal",
      "order": 0,
      "text": "What do you want to do?",
      "type": "single_select",
      "ask_if": true,
      "options": [
        {
          "id": "learn_to_drive",
          "label": "Learn to drive a car or ride a motorcycle/moped, from provisional licence through to passing my test"
        },
        {
          "id": "upgrade_licence",
          "label": "Add a new category or upgrade my existing driving licence (e.g. automatic to manual, car to lorry/bus)"
        },
        {
          "id": "renew_replace_licence",
          "label": "Renew, replace, or change details on my existing driving licence"
        },
        {
          "id": "medical_condition",
          "label": "Tell DVLA about a medical condition or eyesight problem"
        },
        {
          "id": "taxi_phv_licence",
          "label": "Get or renew a taxi or private hire vehicle driver licence"
        },
        {
          "id": "lorry_bus_driver",
          "label": "Become a qualified HGV or bus/coach driver"
        },
        {
          "id": "change_name_gender",
          "label": "Change the name or gender on my driving licence"
        },
        {
          "id": "replace_cbt_certificate",
          "label": "Replace a lost or stolen motorcycle CBT certificate"
        }
      ]
    },
    {
      "id": "q_vehicle_type",
      "order": 1,
      "text": "What type of vehicle are you learning to drive or ride?",
      "type": "single_select",
      "ask_if": {
        "or": [
          {
            "==": [
              "q_main_goal",
              "learn_to_drive"
            ]
          },
          {
            "==": [
              "q_main_goal",
              "upgrade_licence"
            ]
          }
        ]
      },
      "options": [
        {
          "id": "car",
          "label": "Car"
        },
        {
          "id": "motorcycle",
          "label": "Motorcycle"
        },
        {
          "id": "moped",
          "label": "Moped"
        },
        {
          "id": "upgrade_auto_to_manual",
          "label": "Upgrade automatic car licence to manual",
          "needs_evidence": true
        }
      ]
    },
    {
      "id": "q_have_provisional",
      "order": 2,
      "text": "Do you already have a provisional driving licence?",
      "type": "single_select",
      "ask_if": {
        "==": [
          "q_main_goal",
          "learn_to_drive"
        ]
      },
      "options": [
        {
          "id": "yes",
          "label": "Yes, I already have one"
        },
        {
          "id": "no",
          "label": "No, I need to apply for one"
        }
      ]
    },
    {
      "id": "q_car_licence_before_2001",
      "order": 3,
      "text": "Did you pass your car driving test before 1 February 2001?",
      "type": "single_select",
      "ask_if": {
        "==": [
          "q_vehicle_type",
          "moped"
        ]
      },
      "options": [
        {
          "id": "yes",
          "label": "Yes"
        },
        {
          "id": "no",
          "label": "No"
        }
      ]
    },
    {
      "id": "q_cbt_exempt",
      "order": 3,
      "text": "Do any of these apply to you: you already have a full moped licence from a moped test passed since 1 December 1990, you have a full motorcycle licence and are upgrading category, you live on certain offshore islands, or you're riding a trial e-scooter?",
      "type": "single_select",
      "ask_if": {
        "in": [
          "q_vehicle_type",
          [
            "motorcycle",
            "moped"
          ]
        ]
      },
      "options": [
        {
          "id": "yes",
          "label": "Yes, one of these applies"
        },
        {
          "id": "no",
          "label": "No, none of these apply"
        }
      ]
    },
    {
      "id": "q_pip_mobility",
      "order": 3,
      "text": "Do you get, or have you applied for, the higher weekly rate of the mobility part of Personal Independence Payment (PIP)?",
      "type": "single_select",
      "ask_if": {
        "==": [
          "q_vehicle_type",
          "car"
        ]
      },
      "options": [
        {
          "id": "yes",
          "label": "Yes"
        },
        {
          "id": "no",
          "label": "No"
        }
      ]
    },
    {
      "id": "q_accessibility_need",
      "order": 4,
      "text": "Do you have a reading difficulty, health condition or disability you need to tell DVSA about when booking your theory test?",
