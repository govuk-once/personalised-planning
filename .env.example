# --- Mode switch ---
# true = call the local agent container over HTTP
# false  = call the deployed AgentCore runtime via boto3 (IAM/SigV4 auth)
LOCAL_MODE=false
CHAT_MAX_ASSISTANT_TURNS=15
# Set QUESTION_SOURCE=static_questions to use the json question set
QUESTION_SOURCE =

# --- Local mode ---
# Only used when LOCAL_MODE=true.
# In docker-compose this resolves via the "agent" service name; outside
# compose (e.g. running the backend directly on your host) use localhost.
AGENT_URL=http://agent:8080/invocations
# Conversational (information-gathering) agent — its own runtime, fronted by the
# same backend. In compose it resolves via the "chat-agent" service name.
CHAT_AGENT_URL=http://chat-agent:8080/invocations

# --- AgentCore mode ---
# Only used when LOCAL_MODE=false.
AWS_DEFAULT_REGION=eu-west-2
AGENT_RUNTIME_ARN=
AGENT_ENDPOINT_NAME=DEFAULT
# Deployed "conversation" runtime (see agentcore/agentcore.json).
CHAT_AGENT_RUNTIME_ARN=
CHAT_AGENT_ENDPOINT_NAME=DEFAULT

# AWS credentials: locally these come from your aws-vault/gds-cli session
# (mount ~/.aws or pass creds through env when running docker compose with
# LOCAL_MODE=false). In deployed environments, use an IAM role
# with bedrock-agentcore:InvokeAgentRuntime permission instead.
# AgentCore
ANTHROPIC_MODEL=eu.anthropic.claude-sonnet-5

# Secrets Manager (optional locally — remove if using .env for all secrets)
# The chat (conversation) runtime reuses this same secret as the planner.
PLANNER_SECRET_ID=planner-agent

# MCP server
# GRAPH_SERVER_PATH only needed for calling mcp-server locally
MCP_MODE=remote
GRAPH_SERVER_PATH=<path_to_repo>/personalised_planning/mcp-servers/service-graph
GRAPH_GATEWAY_URL=
GRAPH_GATEWAY_ID=

OTEL_SERVICE_NAME=planner-agent
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=https://logs.eu-west-2.amazonaws.com/v1/logs
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://xray.eu-west-2.amazonaws.com/v1/traces
OTEL_LOGS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
