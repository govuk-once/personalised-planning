{
  "name": "PersonalisedPlanning",
  "version": 2,
  "migratedFrom": "v1",
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "PersonalisedPlanning"
  },
  "runtimes": [
    {
      "name": "planner",
      "build": "Container",
      "entrypoint": "app/main.py",
      "codeLocation": "agent/",
      "dockerfile": "Dockerfile",
      "envVars": [
        {
          "name": "CLAUDE_CODE_ENABLE_TELEMETRY",
          "value": "1"
        },
        {
          "name": "CLAUDE_CODE_ENHANCED_TELEMETRY_BETA",
          "value": "1"
        },
        {
          "name": "OTEL_TRACES_EXPORTER",
          "value": "otlp"
        },
        {
          "name": "OTEL_METRICS_EXPORTER",
          "value": "otlp"
        },
        {
          "name": "OTEL_LOGS_EXPORTER",
          "value": "otlp"
        },
        {
          "name": "ANTHROPIC_MODEL",
          "value": "eu.anthropic.claude-sonnet-5"
        }
      ],
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    },
    {
      "name": "conversation",
      "build": "Container",
      "entrypoint": "chat/main.py",
      "codeLocation": "agent/",
      "dockerfile": "Dockerfile.chat",
      "envVars": [
        {
          "name": "CLAUDE_CODE_ENABLE_TELEMETRY",
          "value": "1"
        },
        {
          "name": "CLAUDE_CODE_ENHANCED_TELEMETRY_BETA",
          "value": "1"
        },
        {
          "name": "OTEL_TRACES_EXPORTER",
          "value": "otlp"
        },
        {
          "name": "OTEL_METRICS_EXPORTER",
          "value": "otlp"
        },
        {
          "name": "OTEL_LOGS_EXPORTER",
          "value": "otlp"
        },
        {
          "name": "ANTHROPIC_MODEL",
          "value": "eu.anthropic.claude-sonnet-5"
        },
        {
          "name": "CHAT_MAX_ASSISTANT_TURNS",
          "value": "15"
        }
      ],
      "networkMode": "PUBLIC",
      "protocol": "HTTP"
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "harnesses": []
}
