{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "PersonalisedPlanning",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "PersonalisedPlanning"
  },
  "runtimes": [
    {
      "name": "planner",
      "build": "Container",
      "entrypoint": "app/main.py",
      "codeLocation": "agent/",
      "dockerfile": "Dockerfile",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        { "name": "CLAUDE_CODE_ENABLE_TELEMETRY", "value": "1" },
        { "name": "CLAUDE_CODE_ENHANCED_TELEMETRY_BETA", "value": "1" },
        { "name": "OTEL_TRACES_EXPORTER", "value": "otlp" },
        { "name": "OTEL_METRICS_EXPORTER", "value": "otlp" },
        { "name": "OTEL_LOGS_EXPORTER", "value": "otlp" }
      ]
    },
    {
      "name": "conversation",
      "build": "Container",
      "entrypoint": "chat/main.py",
      "codeLocation": "agent/",
      "dockerfile": "Dockerfile.chat",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        { "name": "CLAUDE_CODE_ENABLE_TELEMETRY", "value": "1" },
        { "name": "CLAUDE_CODE_ENHANCED_TELEMETRY_BETA", "value": "1" },
        { "name": "OTEL_TRACES_EXPORTER", "value": "otlp" },
        { "name": "OTEL_METRICS_EXPORTER", "value": "otlp" },
        { "name": "OTEL_LOGS_EXPORTER", "value": "otlp" }
      ]
    }
  ],
  "memories": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "httpGateways": [],
  "harnesses": [],
  "datasets": []
}
