{
  "name": "planner-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Api and Worker Lambdas: the job store between Next.js and the AgentCore agents",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint src",
    "format": "prettier --write src ../amplify/backend.ts ../amplify/local.ts ../amplify/local ../amplify/jobs-backend",
    "format:check": "prettier --check src ../amplify/backend.ts ../amplify/local.ts ../amplify/local ../amplify/jobs-backend"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1163.0",
    "@aws-sdk/client-dynamodb": "^3.1163.0",
    "@aws-sdk/client-lambda": "^3.1163.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1"
  }
}
